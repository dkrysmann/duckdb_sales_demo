# ---------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and adjust the values.
# Do NOT commit terraform.tfvars to version control (listed in .gitignore).
# ---------------------------------------------------------------------------

aws_region   = "eu-central-1"
bucket_name  = "my-company-sales-data-prd"   # globally unique, lowercase
environment  = "prd"
project      = "sales-pipeline"

# Who may assume the read role?
# Use IAM users, other roles, or AWS services (e.g. Lambda)
reader_trusted_principals = [
  "arn:aws:iam::123456789012:root",                     # administrator
  "arn:aws:iam::123456789012:user/data-analyst",        # individual user
  "arn:aws:iam::123456789012:role/lambda-report-role",  # Lambda function
]

# Who may assume the write role?
writer_trusted_principals = [
  "arn:aws:iam::123456789012:root",                     # administrator
  "arn:aws:iam::123456789012:role/ci-deploy-role",      # CI/CD pipeline
  "arn:aws:iam::123456789012:user/etl-service-account", # ETL service account
]

reader_role_name = "sales-pipeline-s3-reader"
writer_role_name = "sales-pipeline-s3-writer"

versioning_enabled = true
force_destroy      = false   # set to true ONLY for development environments

# log_bucket = "my-company-access-logs"   # uncomment to enable access logging

# IAM users/roles that need bucket-management access (e.g. s3:DeleteBucket).
# The deny policy exempts these principals in addition to the two roles above.
admin_principals = [
  "arn:aws:iam::123456789012:user/aws-user",
]
